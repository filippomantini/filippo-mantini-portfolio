# Only content-fingerprinted assets use immutable caching. HTML stays fresh.
/assets/responsive/*
  Cache-Control: public, max-age=31536000, immutable

/assets/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable
